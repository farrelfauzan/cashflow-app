# Team settings. Every value can be overridden from the environment, for example
#   MODEL_REVIEWER=claude-opus-5-5 ./team/start.sh

TEAM_SESSION="${TEAM_SESSION:-cashflow-team}"

# Models (the orchestrator is fixed to Sonnet 5.5 by request; the rest are your call).
MODEL_ORCHESTRATOR="${MODEL_ORCHESTRATOR:-claude-sonnet-5-5}"
MODEL_BACKEND="${MODEL_BACKEND:-claude-opus-5-5}"
MODEL_FRONTEND="${MODEL_FRONTEND:-claude-opus-5-5}"
MODEL_REVIEWER="${MODEL_REVIEWER:-claude-opus-5-5}"

# acceptEdits: file edits need no prompt; shell commands follow team/settings/<agent>.json.
PERMISSION_MODE="${PERMISSION_MODE:-acceptEdits}"

# How often the orchestrator is asked for its digest.
DIGEST_INTERVAL_SECONDS="${DIGEST_INTERVAL_SECONDS:-3600}"

# The GitHub account the reviewer must be signed in as. It refuses to post as anyone else.
GITHUB_ACCOUNT="${GITHUB_ACCOUNT:-farrelfauzan}"

# The claude binary. A shell function named claude is not visible to scripts, so use the path.
CLAUDE_BIN="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
