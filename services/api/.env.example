# Local development values only. Real secrets for staging and production never go in this file.
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080

# The API connects as the app role. It cannot change the schema or bypass row-level security.
DATABASE_URL=postgres://cashflow_app:cashflow_app_dev@localhost:5432/cashflow?sslmode=disable

# Migrations connect as the owner role.
MIGRATE_DATABASE_URL=postgres://cashflow_owner:owner-dev-password@localhost:5432/cashflow?sslmode=disable

REDIS_ADDR=localhost:6379

# The connection pool of the API and of the worker (default 10). At most QRIS_MAX_CONCURRENT
# payment page requests (default 3, below the pool) wait on AutoGoPay at once, each holding a
# connection, so a slow AutoGoPay never stops the page from loading.
# DATABASE_MAX_CONNS=10
# QRIS_MAX_CONCURRENT=3

# AutoGoPay's gateway; empty uses the real one. Development points at the stand-in
# (make fake-autogopay), so no real QR is made and the demo key never reaches AutoGoPay. Clear it
# only to try a real key by hand.
AUTOGOPAY_BASE_URL=http://127.0.0.1:8091

# Keys the HMAC of login codes. At least 32 bytes. Generate a real one per environment with
# `openssl rand -base64 48` and keep it out of git.
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789

# Master key that encrypts per-organization secrets (AutoGoPay API keys) in the database:
# "<id>:<base64 of 32 random bytes>". The API, the worker and cmd/admin refuse to start without
# a valid one. DEVELOPMENT ONLY: this key is public, so never use it anywhere else. Generate a
# real one per environment with `echo "k1:$(openssl rand -base64 32)"` and keep it out of git.
# Rotation: see the README.
SECRETS_KEY=dev-only:RDXO3fA7ykg/96cLREJRhSwoxN0EEuaM/FwCqFzYwB0=
# Previous keys, decrypt only, comma-separated in the same form. Empty unless rotating.
SECRETS_KEY_PREVIOUS=

# AutoGoPay API key for the local check of the real API (slice 3, S3-0) on a developer machine.
# AutoGoPay has no sandbox, so this is a REAL merchant key: the check only creates an Rp1 QR and
# cancels it. The API and the worker never read this variable, and it never goes to staging or
# production: there each organization's key is stored encrypted with
# `admin set-autogopay-key -org <id>`. Put it in services/api/.env only; never commit it.
AUTOGOPAY_SANDBOX_KEY=

# Browser origins allowed to send state-changing requests, comma-separated. In development the
# Next.js app on :3000 proxies /api to this server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Where people open the web app, for the login link in WhatsApp invitations. An origin only
# (no path). Required outside development, and https there.
PUBLIC_WEB_ORIGIN=http://localhost:3000

# WhatsApp: devlog, gowa or twilio. devlog writes messages, login codes included, to the API
# log (development only). gowa sends through the GOWA container: run `make wa-up`, link a phone
# at http://localhost:3001, then switch WHATSAPP_PROVIDER to gowa.
WHATSAPP_PROVIDER=devlog
GOWA_URL=http://localhost:3001
GOWA_USERNAME=cashflow
GOWA_PASSWORD=gowa-dev-password
GOWA_DEVICE_ID=
# twilio sends through a Twilio sandbox for WhatsApp (development only); see the README.
# TWILIO_WHATSAPP_FROM is the sandbox number shown in the Twilio console, as + and digits.
# TWILIO_CONTENT_SIDS maps our templates to Content templates you created, e.g. login_code=HX...
# A trial account cannot create them, and Twilio's sample template cannot carry a login code;
# on a trial stay on devlog.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# TWILIO_CONTENT_SIDS=
