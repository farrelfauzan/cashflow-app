# Local development values only. Real secrets for staging and production never go in this file.
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080

# The API connects as the app role. It cannot change the schema or bypass row-level security.
DATABASE_URL=postgres://cashflow_app:cashflow_app_dev@localhost:5432/cashflow?sslmode=disable

# Migrations connect as the owner role.
MIGRATE_DATABASE_URL=postgres://cashflow_owner:owner-dev-password@localhost:5432/cashflow?sslmode=disable

REDIS_ADDR=localhost:6379

# Keys the HMAC of login codes. At least 32 bytes. Generate a real one per environment with
# `openssl rand -base64 48` and keep it out of git.
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789

# Browser origins allowed to send state-changing requests, comma-separated. In development the
# Next.js app on :3000 proxies /api to this server.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# WhatsApp. devlog writes messages, login codes included, to the API log (development only).
# gowa sends through the GOWA container: run `make wa-up`, link a phone at
# http://localhost:3001, then switch WHATSAPP_PROVIDER to gowa.
WHATSAPP_PROVIDER=devlog
GOWA_URL=http://localhost:3001
GOWA_USERNAME=cashflow
GOWA_PASSWORD=gowa-dev-password
GOWA_DEVICE_ID=
